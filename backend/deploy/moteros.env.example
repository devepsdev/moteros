# /etc/moteros/moteros.env  — variables de entorno del servicio (chmod 600, root:moteros)
# Copia este archivo, rellena los valores marcados y NO lo subas al repo.

# --- Base de datos ---
DB_URL=jdbc:mysql://localhost:3306/moteros?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Madrid
DB_USER=moteros
DB_PASSWORD=__GENERAR__            # openssl rand -base64 24

# --- JWT ---
# Secreto en Base64, >= 64 bytes:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=__GENERAR__
JWT_EXPIRATION=900000              # access token: 15 min
JWT_REFRESH_EXPIRATION=2592000000  # refresh token: 30 dias

# --- CORS (produccion: SIN comodin) ---
# La app Android nativa no envia Origin, asi que basta con el propio dominio de la API
# y, cuando exista, el origen de la web/PWA.
CORS_ALLOWED_ORIGINS=https://moteros.deveps.dev

# --- Subida de imagenes ---
UPLOADS_DIR=/var/lib/moteros/uploads

# --- JVM / servidor ---
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseSerialGC -Djava.security.egd=file:/dev/urandom
SERVER_PORT=8080
