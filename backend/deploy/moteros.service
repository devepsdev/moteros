# /etc/systemd/system/moteros.service
[Unit]
Description=moter@s API (Spring Boot)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/apps/moteros/
ExecStart=/usr/bin/java -Djava.awt.headless=true -Xms256m -Xmx768m -XX:+UseSerialGC -jar /opt/apps/moteros/moteros.jar --spring.profiles.active=prod --server.port=8080
Restart=always
RestartSec=5
SuccessExitStatus=143

Environment=JAVA_HOME=/usr/lib/jvm/jdk-25.0.4.1-oracle-x64
EnvironmentFile=/opt/apps/moteros/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=moteros

PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
