{
  "expo": {
    "name": "moter@s",
    "slug": "moteros",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moteros",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0F11",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "dev.deveps.moteros"
    },
    "android": {
      "package": "dev.deveps.moteros",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "moter@s necesita acceder a tus fotos para tu perfil, tus motos y tus publicaciones.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "moter@s usa tu ubicación para centrar el mapa al trazar una ruta."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c3299df-6f68-4db4-8656-698a2b663aa5"
      }
    },
    "owner": "devepsdevs-team"
  }
}
